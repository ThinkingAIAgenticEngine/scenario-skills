  "an.027": "clusterUserNum \u662f\u4eba\u7fa4\u5305\u5feb\u7167\u4eba\u6570\uff08\u5bf9\u5e94 clusterUserRefreshTime \u65f6\u70b9\uff09\uff0cplan \u662f\u6548\u679c\u63a5\u53e3\u7edf\u8ba1\u5230\u7684\u4eba\u7fa4\u89c4\u6a21\uff1b\u5dee\u5f02\u901a\u5e38\u6765\u81ea\u4eba\u7fa4\u5237\u65b0\u4e0e\u9891\u63a7\u8fc7\u6ee4\uff0c\u5c5e\u6b63\u5e38\u53e3\u5f84\u5dee\uff0c\u4e0d\u4ee3\u8868\u53d6\u6570\u9519\u8bef\u3002",
