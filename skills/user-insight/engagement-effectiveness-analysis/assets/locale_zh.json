  "an.031": "\u5408\u8ba1",
  "an.032": "\u26a0\ufe0f \u5b9e\u4f8b\u7ef4\u5ea6 z \u975e\u5217\u8868\uff08%s\uff09\uff0c\u8df3\u8fc7\u5b9e\u4f8b\u660e\u7ec6",
  "an.033": "\u26a0\ufe0f \u5b9e\u4f8b\u6570\u636e\u8df3\u8fc7\u975e\u5bf9\u8c61\u8bb0\u5f55: %r",
  "an.034": "\u26a0\ufe0f \u8f6c\u5316\u6307\u6807\u5b9a\u4e49\u8df3\u8fc7\u975e\u5bf9\u8c61\u8bb0\u5f55: %r",
  "an.035": "\u5929",
