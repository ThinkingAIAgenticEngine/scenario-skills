  "an.038": "\u26a0\ufe0f \u5b9e\u9a8c\u5206\u7ec4\u8df3\u8fc7\u975e\u5bf9\u8c61\u8bb0\u5f55: %r",
  "an.039": "\u5bf9\u7167\u7ec4",
  "an.040": "\u5b9e\u9a8c\u7ec4",
  "an.041": "\u672a\u77e5",
  "an.042": "\u65e0\u6cd5\u5224\u5b9a",
  "an.043": "\u5b9e\u9a8c\u7ec4 lift\u22480 \u4e14\u672a\u56de\u4f20\u7f6e\u4fe1\u533a\u95f4\u4e0e\u663e\u8457\u6027\u6c34\u5e73\uff0c\u65e0\u6cd5\u786e\u8ba4\u589e\u91cf\u6548\u679c\u3002\u9700\u68c0\u67e5\u5b9e\u9a8c\u6307\u6807\u7684\u8f6c\u5316\u56de\u4f20\u662f\u5426\u5df2\u5f00\u542f\u2014\u2014\u5f53\u524d successUserNum \u4e0e\u89e6\u8fbe\u6210\u529f\u6570\u4e00\u81f4\uff0c\u7591\u4e3a\u5b9e\u9a8c\u672a\u63a5\u5165\u8f6c\u5316\u53e3\u5f84\u3002",
  "an.044": "\u5b9e\u9a8c\u7ec4\u672a\u56de\u4f20 lift\uff0c\u65e0\u6cd5\u5224\u5b9a\u4f18\u52a3\u3002",
  "an.045": "\u9700\u89c2\u5bdf",
  "an.046": "\u5b9e\u9a8c\u7ec4\u80dc\u51fa",
  "an.047": "\u65e0\u663e\u8457\u5dee\u5f02",
  "an.048": "\u6570\u636e\u4e0d\u8db3",
  "an.049": "\u6570\u636e\u5f02\u5e38\uff08\u6bd4\u7387\u8d85\u8fc7 100%\uff09",
  "an.050": "\u6b63\u5e38",
  "an.051": "\u65e0\u57fa\u51c6",
  "an.052": "\u6570\u636e\u4e00\u81f4\u6027",
  "an.053": "\u5206\u5b50\u672c\u5e94\u662f\u5206\u6bcd\u7684\u5b50\u96c6\uff0c\u6bd4\u7387\u8d85\u8fc7 100% \u5728\u7269\u7406\u4e0a\u4e0d\u53ef\u80fd\u3002\u901a\u5e38\u610f\u5473\u7740\u4e0a\u6e38\u6f0f\u62a5\u4e86\u5206\u6bcd\u4e8b\u4ef6\uff08\u4f8b\u5982\u53ea\u4e0a\u62a5\u70b9\u51fb\u3001\u672a\u4e0a\u62a5\u66dd\u5149\uff09\u3002\u5728\u8865\u9f50\u4e8b\u4ef6\u524d\uff0c\u672c\u62a5\u544a\u7684\u6f0f\u6597\u4e0e\u7ed3\u8bba\u5747\u4e0d\u53ef\u4fe1\u3002",
  "an.054": "2-\u94fe\u8def\u6f0f\u6597",
  "an.055": "\u6570\u636e\u94fe\u65ad\u88c2",
  "an.056": "\u6307\u6807\u672a\u8fbe\u6807",
  "an.057": "\u901a\u9053\u95ee\u9898",
  "an.058": "\u4f4e\u4e8e 90% \u57fa\u51c6\uff0c\u7591\u4f3c\u901a\u9053\u9650\u6d41\u3001Token \u5931\u6548\u6216\u901a\u9053\u914d\u7f6e\u5f02\u5e38\u3002",
  "an.059": "\u5b9e\u9a8c\u65e0\u6548",
  "an.060": "6-\u7b56\u7565\u4e0e\u5206\u7ec4\u5bf9\u6bd4",
  "an.061": "\uff08\u5206\u6bcd\u5df2\u964d\u7ea7\u4e3a\u4e0b\u53d1\u6570\uff09",
  "an.062": "\u5185\u5bb9\u65f6\u673a",
  "an.063": "\u4f4e\u4e8e Push 3% \u57fa\u51c6\uff0c\u9700\u68c0\u67e5\u6587\u6848\u3001\u89e6\u8fbe\u65f6\u673a\u4e0e\u4eba\u7fa4\u5339\u914d\u5ea6\u3002",
  "an.064": "\u672a\u53d1\u73b0\u660e\u663e\u95ee\u9898",
  "an.065": "\u5404\u73af\u8282\u5747\u5728\u57fa\u51c6\u7ebf\u5185",
  "an.066": "\u94fe\u8def\u3001\u901a\u9053\u3001\u5b9e\u9a8c\u3001\u70b9\u51fb\u7387\u5747\u6b63\u5e38\u3002",
  "an.067": "\u786e\u8ba4\u5ba2\u6237\u7aef\u57cb\u70b9\u662f\u5426\u6b63\u5e38\u4e0a\u62a5\u3001\u5e73\u53f0\u4fa7\u56de\u6267\u662f\u5426\u5f00\u542f\u3002\u82e5\u662f\u5e73\u53f0\u672a\u914d\u7f6e\u56de\u6267\uff0c\u8054\u7cfb\u6570\u6570\u6280\u672f\u652f\u6301\u5f00\u542f\u8be5\u901a\u9053\u56de\u6267\uff1b\u82e5\u662f\u5ba2\u6237\u81ea\u5efa\u540e\u53f0\uff0c\u786e\u8ba4\u662f\u5426\u628a\u7ed3\u679c\u56de\u4f20\u5230\u6570\u6570\u3002",
  "an.068": "\u8865\u9f50\u540e\u8be5\u73af\u8282\u53ca\u4e0b\u6e38\u6307\u6807\u65b9\u53ef\u8bc4\u4f30\uff0c\u662f\u672c\u6b21\u5206\u6790\u7ee7\u7eed\u6df1\u5165\u7684\u524d\u63d0",
  "an.069": "\u8be5\u6307\u6807\u4f4e\u4e8e\u884c\u4e1a\u57fa\u51c6\uff0c\u4e14\u6309\u5f53\u524d\u5206\u6bcd\u4f30\u7b97\u53ef\u633d\u56de\u4eba\u6570\u6700\u591a\uff0c\u662f\u6295\u5165\u4ea7\u51fa\u6bd4\u6700\u9ad8\u7684\u4e00\u73af\u3002\u7ed3\u5408\u6e20\u9053\u9650\u6d41\u3001\u7528\u6237\u5728\u7ebf\u65f6\u6bb5\u3001\u6d88\u606f\u4f18\u5148\u7ea7\u3001\u6587\u6848\u4e0e\u5207\u5165\u70b9\u7efc\u5408\u6392\u67e5\u3002",
  "an.070": "\u63d0\u5347\u81f3\u57fa\u51c6\u6c34\u5e73\uff0c\u53ef\u663e\u8457\u653e\u5927\u5168\u90e8\u4e0b\u6e38\u6307\u6807",
  "an.071": "\u6392\u67e5\u901a\u9053\u914d\u7f6e\u4e0e Token \u6709\u6548\u6027",
  "an.072": "\u68c0\u67e5\u63a8\u9001\u901a\u9053\u9650\u6d41\u9608\u503c\u3001\u8bc1\u4e66/Token \u6709\u6548\u671f\u3001\u901a\u9053\u5546\u8fd4\u56de\u7801\u5206\u5e03\u3002",
  "an.073": "\u53d1\u9001\u6210\u529f\u7387\u63d0\u5347\u81f3 90% \u4ee5\u4e0a\uff0c\u76f4\u63a5\u653e\u5927\u6240\u6709\u4e0b\u6e38\u6307\u6807",
  "an.074": "\u7ec8\u6b62\u65e0\u589e\u91cf\u5b9e\u9a8c\u7ec4 / \u91cd\u65b0\u8bbe\u8ba1\u5b9e\u9a8c",
  "an.075": "\u5f53\u524d\u5b9e\u9a8c\u7b56\u7565\u672a\u5e26\u6765\u663e\u8457\u589e\u91cf\uff0c\u5efa\u8bae\u5173\u95ed\u5b9e\u9a8c\u7ec4\u8282\u7701\u89e6\u8fbe\u8d44\u6e90\uff0c\u6216\u66f4\u6362\u5b9e\u9a8c\u53d8\u91cf\uff08\u6587\u6848 / \u65f6\u673a / \u4eba\u7fa4\uff09\u540e\u91cd\u5f00\u5b9e\u9a8c\u3002",
  "an.076": "\u91ca\u653e\u65e0\u6548\u5b9e\u9a8c\u5360\u7528\u7684\u89e6\u8fbe\u914d\u989d\uff0c\u907f\u514d\u6253\u6270\u7528\u6237",
  "an.077": "A/B \u6d4b\u8bd5\u6587\u6848\u4e0e\u89e6\u8fbe\u65f6\u673a",
  "an.078": "\u5bf9\u6587\u6848\u4e3b\u6807\u9898\u3001CTA\u3001\u53d1\u9001\u65f6\u6bb5\uff08\u5982 12:00 vs 20:00\uff09\u5efa AB \u5b9e\u9a8c\uff0c\u5355\u53d8\u91cf\u5bf9\u7167\u3002",
  "an.079": "\u70b9\u51fb\u7387\u63d0\u5347 1-2 \u4e2a\u767e\u5206\u70b9",
  "an.080": "\u7ef4\u6301\u5f53\u524d\u7b56\u7565\uff0c\u8f6c\u5165\u589e\u91cf\u9a8c\u8bc1",
  "an.081": "\u5404\u73af\u8282\u5747\u5728\u57fa\u51c6\u7ebf\u5185\uff0c\u5f53\u524d\u7b56\u7565\u65e0\u9700\u8c03\u6574\u3002\u4e0b\u4e00\u6b65\u5e94\u786e\u8ba4\u8fd9\u6bb5\u6548\u679c\u662f\u771f\u5b9e\u589e\u91cf\uff0c\u800c\u975e\u672c\u6765\u5c31\u4f1a\u53d1\u751f\u7684\u884c\u4e3a\u2014\u2014\u5efa\u8bae\u4fdd\u7559\u5bf9\u7167\u7ec4\u8dd1\u4e00\u8f6e AB\uff0c\u6216\u6269\u5c55\u5230\u76f8\u4f3c\u4eba\u7fa4\u9a8c\u8bc1\u53ef\u590d\u5236\u6027\u3002",
  "an.082": "\u786e\u8ba4\u589e\u91cf\u800c\u975e\u81ea\u7136\u6d41\u91cf\uff0c\u4e3a\u653e\u91cf\u63d0\u4f9b\u4f9d\u636e",
  "an.083": "\u62d3\u5c55\u5230\u9ad8\u54cd\u5e94\u76f8\u4f3c\u4eba\u7fa4",
  "an.084": "\u4ee5\u672c\u6b21\u54cd\u5e94\u4eba\u7fa4\u4e3a\u79cd\u5b50\uff0c\u7528\u5176\u6d3b\u8dc3\u5ea6 / \u4ed8\u8d39\u5c42\u7ea7 / \u751f\u547d\u5468\u671f\u7684\u5206\u5e03\u5708\u5b9a\u76f8\u4f3c\u4eba\u7fa4\u505a\u6269\u91cf\u6d4b\u8bd5\u3002",
  "an.085": "\u5728\u7ef4\u6301\u8f6c\u5316\u7387\u7684\u524d\u63d0\u4e0b\u6269\u5927\u89e6\u8fbe\u89c4\u6a21",
  "an.086": "\u5148\u8865\u9f50\u6570\u636e\u56de\u4f20\uff0c\u518d\u8bc4\u4f30\u4f18\u5316\u65b9\u5411",
  "an.087": "\u672c\u6b21\u6ca1\u6709\u4efb\u4f55\u6307\u6807\u53ef\u8ba1\u7b97\uff0c\u65e0\u6cd5\u5224\u65ad\u94fe\u8def\u8868\u73b0\uff0c\u4e5f\u5c31\u4e0d\u5b58\u5728\u53ef\u6267\u884c\u7684\u4f18\u5316\u52a8\u4f5c\u3002\u9700\u5148\u786e\u8ba4\u56de\u6536\u4e8b\u4ef6\u662f\u5426\u6b63\u786e\u3001\u5ba2\u6237\u7aef\u662f\u5426\u4e0a\u62a5\u3001\u65f6\u95f4\u7a97\u5185\u662f\u5426\u786e\u6709\u89e6\u8fbe\u3002",
  "an.088": "\u5efa\u7acb\u53ef\u89c2\u6d4b\u57fa\u7ebf\u540e\uff0c\u624d\u80fd\u8fdb\u5165\u6548\u679c\u8bca\u65ad\u4e0e\u4f18\u5316",
  "an.089": "\u8bb0\u5f55\u672c\u6b21\u5206\u6790\u7684\u57fa\u7ebf\u6307\u6807\uff08\u89c1\u4e0a\u65b9\u57fa\u7ebf\u6307\u6807\u8868\uff09",
  "an.090": "\u8c03\u6574\u7b56\u7565\u540e\uff0c\u7528\u76f8\u540c\u4eba\u7fa4\u53e3\u5f84\u4e0e\u65f6\u95f4\u7a97\u91cd\u8dd1\u4e00\u6b21",
  "an.091": "\u5bf9\u6bd4\u6838\u5fc3\u6307\u6807\u53d8\u5316\uff0c\u53d8\u5316\u5e45\u5ea6\u8d85\u8fc7 5% \u4e14\u6837\u672c\u91cf\u8db3\u591f\u65f6\u5224\u5b9a\u6709\u6548",
  "an.092": "\u82e5\u4ecd\u9700\u4e25\u683c\u9a8c\u8bc1\uff0c\u65b0\u5efa AB \u5b9e\u9a8c\uff08\u5bf9\u7167\u7ec4\u4fdd\u7559\u539f\u7b56\u7565\uff09",
  "an.093": "\u672c\u6b21\u6ca1\u6709\u4efb\u4f55\u6307\u6807\u53ef\u8ba1\u7b97\uff0c\u65e0\u6cd5\u5efa\u7acb\u57fa\u7ebf\uff0c\u4e0a\u65b9\u76ee\u6807\u503c\u5747\u4e3a\u7a7a\u3002\u9700\u5148\u8ba9\u6570\u636e\u56de\u4f20\u53ef\u7528\uff0c\u518d\u91cd\u8dd1\u4e00\u6b21\u4ee5\u53d6\u5f97\u57fa\u7ebf\u3002",
  "an.094": "\u5148\u8865\u9f50\u6570\u636e\u56de\u4f20\uff08\u786e\u8ba4\u56de\u6536\u4e8b\u4ef6 / \u5ba2\u6237\u7aef\u4e0a\u62a5 / \u65f6\u95f4\u7a97\uff09\uff0c\u91cd\u8dd1\u53d6\u5f97\u57fa\u7ebf",
  "an.095": "\u91cd\u8dd1\u540c\u7b56\u7565 + \u5bf9\u7167\u57fa\u7ebf",
